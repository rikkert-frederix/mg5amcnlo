      SUBROUTINE SBORN(P,ANS_SUMMED)
C
%(info_lines)s
C
C     Evaluate the single maximally QCD-like Born contribution and
C     construct its QCD counterterm weights.
C
%(process_lines)s
C
      IMPLICIT NONE
      INCLUDE 'nexternal.inc'
      REAL*8 P(0:3,NEXTERNAL-1)
      DOUBLE PRECISION ANS_SUMMED
      COMPLEX*16 ANS(2,0:1)

      CALL SBORN_SPLITORDERS(P,ANS)
      CALL SBORN_FINALIZE_SPLITORDERS(ANS,ANS_SUMMED)
      RETURN
      END


      SUBROUTINE SBORN_FINALIZE_SPLITORDERS(ANS,ANS_SUMMED)
      IMPLICIT NONE
      INCLUDE 'nexternal.inc'
      INTEGER NAMPSO, NSQAMPSO
      PARAMETER (NAMPSO=%(nAmpSplitOrders)d, NSQAMPSO=1)
      INTEGER NGRAPHS
      PARAMETER (NGRAPHS=%(ngraphs)d)

      DOUBLE PRECISION ANS_SUMMED

      INTEGER I,J
      INCLUDE 'orders.inc'
      COMPLEX*16 ANS(2,0:NSQAMPSO), ANS_CNT(2,NSPLITORDERS)
      COMMON /C_BORN_CNT/ ANS_CNT
      INTEGER AMP_ORDERS(NSPLITORDERS)
      DOUBLE PRECISION TINY, MAX_VAL
      PARAMETER (TINY=1D-12)
      DOUBLE PRECISION WGT_ME_BORN,WGT_ME_REAL
      COMMON /C_WGT_ME_TREE/ WGT_ME_BORN,WGT_ME_REAL

      DOUBLE PRECISION AMP2B(NGRAPHS),JAMP2B(0:%(ncolor)d,0:NAMPSO)
      COMMON /TO_AMPS_BORN/ AMP2B,JAMP2B
      DOUBLE PRECISION AMP2(NGRAPHS),JAMP2(0:%(ncolor)d)
      COMMON /TO_AMPS/ AMP2,JAMP2

      INTEGER GETORDPOWFROMINDEX_B
      INTEGER ORDERS_TO_AMP_SPLIT_POS

      ANS_SUMMED=ANS(1,1)
      MAX_VAL=ABS(ANS(1,1))
      IF (ABS(ANS_SUMMED).LT.MAX_VAL*TINY) ANS_SUMMED=0D0
      WGT_ME_BORN=ANS_SUMMED

      AMP_SPLIT(1:AMP_SPLIT_SIZE)=0D0
      AMP_SPLIT_CNT(1:AMP_SPLIT_SIZE,1:2,1:NSPLITORDERS)=
     $     DCMPLX(0D0,0D0)
      ANS_CNT(1:2,1:NSPLITORDERS)=DCMPLX(0D0,0D0)
      DO J=1,NSPLITORDERS
        AMP_ORDERS(J)=GETORDPOWFROMINDEX_B(J,1)
      ENDDO
      IF (ABS(ANS(1,1)).GT.MAX_VAL*TINY) THEN
        AMP_SPLIT(ORDERS_TO_AMP_SPLIT_POS(AMP_ORDERS))=ANS(1,1)
      ENDIF

      AMP2(1:NGRAPHS)=AMP2B(1:NGRAPHS)
      DO I=0,INT(JAMP2B(0,0))
        JAMP2(I)=0D0
        DO J=1,NAMPSO
          JAMP2(I)=JAMP2(I)+JAMP2B(I,J)
        ENDDO
      ENDDO

%(skip_amp_cnt)s
      ANS_CNT(1:2,QCD_POS)=ANS(1:2,1)
      DO J=1,NSPLITORDERS
        AMP_ORDERS(J)=GETORDPOWFROMINDEX_B(J,1)
      ENDDO
      AMP_ORDERS(QCD_POS)=AMP_ORDERS(QCD_POS)+2
      IF (ABS(ANS(1,1)).GT.MAX_VAL*TINY) THEN
        AMP_SPLIT_CNT(ORDERS_TO_AMP_SPLIT_POS(AMP_ORDERS),1,QCD_POS)=
     $       ANS(1,1)
      ENDIF
      IF (ABS(ANS(2,1)).GT.MAX_VAL*TINY) THEN
        AMP_SPLIT_CNT(ORDERS_TO_AMP_SPLIT_POS(AMP_ORDERS),2,QCD_POS)=
     $       ANS(2,1)
      ENDIF
      IF (ABS(ANS_CNT(1,QCD_POS)).LT.MAX_VAL*TINY)
     $     ANS_CNT(1,QCD_POS)=(0D0,0D0)
      IF (ABS(ANS_CNT(2,QCD_POS)).LT.MAX_VAL*TINY)
     $     ANS_CNT(2,QCD_POS)=(0D0,0D0)

 999  RETURN
      END
