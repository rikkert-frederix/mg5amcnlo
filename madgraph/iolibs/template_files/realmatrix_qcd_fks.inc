      SUBROUTINE SMATRIX%(proc_prefix)s(P,ANS_SUMMED)
C
%(info_lines)s
C
C     Evaluate the single real-emission coupling order generated by a
C     QCD correction to the selected Born contribution.
C
%(process_lines)s
C
      IMPLICIT NONE
      INTEGER NEXTERNAL
      PARAMETER (NEXTERNAL=%(nexternal)d)
      REAL*8 P(0:3,NEXTERNAL),ANS_SUMMED
      REAL*8 ANS(0:1)

      CALL SMATRIX%(proc_prefix)s_SPLITORDERS(P,ANS)
      CALL SMATRIX%(proc_prefix)s_FINALIZE_SPLITORDERS(ANS,ANS_SUMMED)
      RETURN
      END


      SUBROUTINE SMATRIX%(proc_prefix)s_FINALIZE_SPLITORDERS(
     $ ANS,ANS_SUMMED)
      IMPLICIT NONE
      INTEGER NSQAMPSO
      PARAMETER (NSQAMPSO=1)

      REAL*8 ANS_SUMMED

      INTEGER J
      REAL*8 ANS(0:NSQAMPSO)
      INCLUDE 'orders.inc'
      INTEGER AMP_ORDERS(NSPLITORDERS)
      DOUBLE PRECISION ANS_MAX,TINY
      PARAMETER (TINY=1D-12)
      DOUBLE PRECISION WGT_ME_BORN,WGT_ME_REAL
      COMMON /C_WGT_ME_TREE/ WGT_ME_BORN,WGT_ME_REAL

      INTEGER GETORDPOWFROMINDEX%(proc_prefix)s
      INTEGER ORDERS_TO_AMP_SPLIT_POS

      ANS_SUMMED=ANS(1)
      ANS_MAX=ABS(ANS(1))

      AMP_SPLIT(1:AMP_SPLIT_SIZE)=0D0
      DO J=1,NSPLITORDERS
        AMP_ORDERS(J)=GETORDPOWFROMINDEX%(proc_prefix)s(J,1)
      ENDDO
      IF (ABS(ANS(1)).GT.ANS_MAX*TINY) THEN
        AMP_SPLIT(ORDERS_TO_AMP_SPLIT_POS(AMP_ORDERS))=ANS(1)
      ENDIF
      IF (ABS(ANS_SUMMED).LT.TINY*ANS_MAX) ANS_SUMMED=0D0

      WGT_ME_REAL=ANS_SUMMED
      END
