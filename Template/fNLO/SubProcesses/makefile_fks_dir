include ../proc_characteristics
include ../../Source/make_opts
include ../analyse_opts

LIBDIR = $(abspath ../../lib/)/
ANADIR = ../../FixedOrderAnalysis/


#check if fastjet-config is set
ifdef fastjet_config
    FASTJET_CONFIG = $(fastjet_config)
    CXXFLAGS += $(shell $(FASTJET_CONFIG) --cxxflags)
    FJLIBS += $(shell $(FASTJET_CONFIG) --libs --plugins ) $(STDLIB)
    fastjetfortran_madfks=fastjetfortran_madfks_full.o \
        fastjet_wrapper.o
else
    fastjetfortran_madfks=fastjetfortran_madfks_core.o fjcore.o \
        fastjet_wrapper.o
    FJLIBS += $(STDLIB)
endif

NLOLIBS=-L$(LIBDIR) $(libmadloop) $(libcuttools) $(libOLP)

# Uncomment the line below to compile with MadLoop without setting the environnement 
# variables 'by hand'
# NLOLIBS= -L. -lMadLoop -L$(LIBDIR) -lcts
LINKLIBS = -L$(LIBDIR) -ldhelas -lgeneric -lmodel -lpdf $(llhapdf)
LIBS = $(LIBDIR)libdhelas.a $(LIBDIR)libgeneric.a $(LIBDIR)libmodel.a	\
$(LIBDIR)libpdf.a

ifneq ("$(wildcard ../../Source/RUNNING)","")
    LINKLIBS += -lrunning
    LIBS += $(LIBDIR)librunning.$(libext) 
endif

ifeq ($(strip $(pineappl_interface)),pineappl_interface_dummy.o)
pineappl_interface_bridge = pineappl_interface_dummy_bridge.o
endif



# Files for all executables
FILES= fnlo_process_common.o process_dimensions.o			\
	 process_dimensions_bridge.o					\
	 fks_metadata.o fks_metadata_bridge.o				\
	 $(patsubst %.f,%.o,$(wildcard parton_lum_*.f)) 			\
	 $(patsubst %.f,%.o,$(wildcard matrix_*.f)) 			\
	 FKSParams.o real_me_chooser.o chooser_functions.o		\
	 chooser_functions_bridge.o					\
	 genps_born.o genps_fks.o genps_fks_bridge.o			\
	 kinematic_runtime_state.o					\
	 setcuts.o						\
	 setcuts_bridge.o						\
	 setscales.o setscales_bridge.o				\
	 $(patsubst %.f,%.o,$(wildcard b_sf_???.f)) 			\
	 born.o sborn_sf.o extra_cnt_wrapper.o				\
	 $(patsubst %.f,%.o,$(wildcard born_cnt_*.f))			\
	 fks_Sij.o $(fastjetfortran_madfks)				\
	 fks_singular.o fks_singular_bridge.o			\
	 boostwdir2.o       					\
	 splitorders_stuff.o					\
	 splitorders_stuff_bridge.o					\
	 get_color.o iproc_map.o iproc_map_bridge.o			\
	 MC_integer.o						\
	 $(pineappl_interface) $(pineappl_interface_bridge) weight_lines.o \
	 mint_module.o polfit.o

# Every shipped analysis is a module plus one external-ABI bridge.  Derive the
# companion object here as well as in FOAnalyseCard so hand-written
# analyse_opts files cannot silently omit it.  Linking two bridges would define
# analysis_begin/end/fill twice, so reject that selection at parse time.
FNLO_MODULE_ANALYSES = \
	analysis_HwU_general.o \
	analysis_HwU_pp_V.o analysis_HwU_pp_h.o \
	analysis_HwU_pp_hjj.o \
	analysis_HwU_pp_lplm.o analysis_HwU_pp_lvl.o \
	analysis_HwU_pp_lvl2.o analysis_HwU_pp_taptam.o \
	analysis_HwU_pp_tj.o analysis_HwU_pp_ttx.o \
	analysis_HwU_pp_ttx_v2.o \
	analysis_HwU_template.o
FNLO_MODULE_ANALYSIS_BRIDGES = \
	$(patsubst %.o,%_bridge.o,$(FNLO_MODULE_ANALYSES))
FNLO_SELECTED_ANALYSES = $(filter $(FNLO_MODULE_ANALYSES),$(FO_ANALYSE))
ifneq ($(word 2,$(FNLO_SELECTED_ANALYSES)),)
$(error Select only one shipped fNLO analysis module in FO_ANALYSE)
endif
FNLO_SELECTED_ANALYSIS_BRIDGES = \
	$(patsubst %.o,%_bridge.o,$(FNLO_SELECTED_ANALYSES))
FNLO_AUTO_ANALYSIS_BRIDGES = \
	$(filter-out $(FO_ANALYSE),$(FNLO_SELECTED_ANALYSIS_BRIDGES))
FNLO_DUMMY_ANALYSIS_BRIDGES = \
	$(if $(filter analysis_dummy.o,$(FO_ANALYSE)),analysis_dummy_bridge.o) \
	$(if $(filter HwU_dummy.o,$(FO_ANALYSE)),HwU_dummy_bridge.o)
FNLO_AUTO_DUMMY_ANALYSIS_BRIDGES = \
	$(filter-out $(FO_ANALYSE),$(FNLO_DUMMY_ANALYSIS_BRIDGES))

# Sources using process-sized shared storage must wait for the module file.
FNLO_PROCESS_COMMON_USERS = \
	analysis_HwU_general.o HwU_bridge.o \
	BinothLHA.o BinothLHA_bridge.o \
	BinothLHA_OLP.o BinothLHA_OLP_bridge.o \
	BinothLHA_user_bridge.o check_poles.o check_poles_bridge.o \
	chooser_functions_bridge.o cuts_bridge.o \
	driver_mintFO.o driver_mintFO_bridge.o \
	fks_singular.o fks_singular_bridge.o \
	genps_born.o genps_fks.o genps_fks_bridge.o \
	iproc_map_bridge.o madfks_plot.o madfks_plot_bridge.o \
	MC_integer.o mint_module.o open_output_files_bridge.o \
	process_dimensions_bridge.o setcuts_bridge.o \
	setscales.o setscales_bridge.o symmetry_fks_v3_bridge.o \
	test_soft_col_limits_bridge.o
FNLO_EXPLICIT_ANALYSIS_BRIDGES = \
	$(filter $(FNLO_MODULE_ANALYSIS_BRIDGES),$(FO_ANALYSE))
FNLO_WRONG_ANALYSIS_BRIDGES = \
	$(filter-out $(FNLO_SELECTED_ANALYSIS_BRIDGES), \
	$(FNLO_EXPLICIT_ANALYSIS_BRIDGES))
ifneq ($(strip $(FNLO_WRONG_ANALYSIS_BRIDGES)),)
$(error The selected fNLO analysis bridge does not match its module)
endif
FNLO_LINKED_ANALYSIS_BRIDGES = \
	$(sort $(FNLO_AUTO_ANALYSIS_BRIDGES) \
	$(FNLO_EXPLICIT_ANALYSIS_BRIDGES))
ifneq ($(word 2,$(FNLO_LINKED_ANALYSIS_BRIDGES)),)
$(error Only one fNLO analysis ABI bridge may be linked)
endif


# Files needed for mintFO
RUN= $(FO_ANALYSE) $(FNLO_AUTO_ANALYSIS_BRIDGES) \
	$(FNLO_AUTO_DUMMY_ANALYSIS_BRIDGES) $(FILES) \
	cuts.o cuts_bridge.o			\
	dummy_fct.o						\
	born_hel.o open_output_files.o open_output_files_bridge.o	\
	madfks_plot.o madfks_plot_bridge.o

# Files for mintFO
MINTFO= $(RUN) driver_mintFO.o driver_mintFO_bridge.o BinothLHA.o \
	BinothLHA_bridge.o

# Files for check_poles
POLES= $(RUN) check_poles.o check_poles_bridge.o BinothLHA.o \
	BinothLHA_bridge.o

# Files for the matrix-element soft/collinear limit test
TEST= $(RUN) test_soft_col_limits.o test_soft_col_limits_bridge.o \
	BinothLHADummy.o BinothLHADummy_bridge.o

# Files for gensym
SYM= $(RUN) BinothLHADummy.o BinothLHADummy_bridge.o \
	symmetry_fks_v3.o						\
	symmetry_fks_v3_bridge.o write_ajob.o

%.o: %.f
	$(FC) $(FFLAGS) -c -I. -I$(LIBDIR) $<
%.o: %.f90
	$(FC) $(FFLAGS) -c -I. -I$(LIBDIR) $<
%.o: $(ANADIR)/%.f
	$(FC) $(FFLAGS) -c -I. -I$(LIBDIR) -I$(ANADIR) $(FO_INCLUDEPATHS) $<
%.o: $(ANADIR)/%.f90
	$(FC) $(FFLAGS) -c -I. -I$(LIBDIR) -I$(ANADIR) $(FO_INCLUDEPATHS) $<
%.o: %.for
	$(FC) $(FFLAGS) -c -I. -I$(ANADIR) $<
%.o: $(ANADIR)/%.for
	$(FC) $(FFLAGS) -c -I. -I$(LIBDIR) -I$(ANADIR) $(FO_INCLUDEPATHS) $<
%.o: %.c
	$(CXX) $(CFLAGS) -c -I. $^
%.o: $(ANADIR)/%.c
	$(CXX) $(CFLAGS) -c -I. -I$(ANADIR) $(FO_INCLUDEPATHS) $^
%.o: %.cc
	$(CXX) $(CXXFLAGS) -c -I. $^
%.o: $(ANADIR)/%.cc
	$(CXX) $(CXXFLAGS) -c -I. -I$(ANADIR) $(FO_INCLUDEPATHS) $^

gensym: $(SYM)
	$(FC) $(LDFLAGS) -o gensym $(SYM) $(APPLLIBS) $(LINKLIBS) $(FO_EXTRAPATHS) $(FO_EXTRALIBS) $(FJLIBS)
	rm fks_singular.o
	strip gensym

test_soft_col_limits: $(TEST) mint_module.o
	$(FC) $(LDFLAGS) -o test_soft_col_limits $(TEST) $(APPLLIBS) $(LINKLIBS) $(FO_EXTRAPATHS) $(FO_EXTRALIBS) $(FJLIBS)
	rm test_soft_col_limits.o
	strip test_soft_col_limits

$(LIBDIR)/libdhelas.$(dylibext):
	$(MAKE) -C "$(LIBDIR)/../Source/DHELAS" shared
$(LIBDIR)/libmodel.$(dylibext):
	$(MAKE) -C "$(LIBDIR)/../Source/MODEL" shared

check_poles: $(POLES) $(libmadloop)
	$(FC) -o check_poles $(POLES) $(NLOLIBS) $(APPLLIBS) $(LINKLIBS) $(FJLIBS) $(FO_EXTRAPATHS) $(FO_EXTRALIBS) $(LDFLAGS)
	strip check_poles

madevent_mintFO: $(MINTFO) $(libmadloop) makefile $(LIBS)
	$(FC) -o madevent_mintFO $(MINTFO) $(NLOLIBS) $(APPLLIBS) $(LINKLIBS) $(FJLIBS) $(FO_EXTRAPATHS) $(FO_EXTRALIBS) $(LDFLAGS)
	strip madevent_mintFO

libMadLoop.a:
	for dir in `ls -d V*`; do cd $$dir; make; cd ../; done

