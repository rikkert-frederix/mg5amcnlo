# Every shipped analysis is a module plus one external-ABI bridge.  Derive the
# companion object here as well as in FOAnalyseCard so hand-written
# analyse_opts files cannot silently omit it.  Linking two bridges would define
# analysis_begin/end/fill twice, so reject that selection at parse time.
FNLO_MODULE_ANALYSES = \
	analysis_HwU_general.o analysis_HwU_general_sdk.o \
	analysis_HwU_pp_V.o analysis_HwU_pp_h.o \
	analysis_HwU_pp_hjj.o \
	analysis_HwU_pp_lplm.o analysis_HwU_pp_lvl.o \
	analysis_HwU_pp_lvl2.o analysis_HwU_pp_taptam.o \
	analysis_HwU_pp_tj.o analysis_HwU_pp_ttx.o \
	analysis_HwU_pp_ttx_v2.o analysis_HwU_pp_wpz.o \
	analysis_HwU_template.o analysis_pp_wz_ewsud.o
FNLO_MODULE_ANALYSIS_BRIDGES = \
	$(patsubst %.o,%_bridge.o,$(FNLO_MODULE_ANALYSES))
FNLO_SELECTED_ANALYSES = $(filter $(FNLO_MODULE_ANALYSES),$(FO_ANALYSE))
ifneq ($(word 2,$(FNLO_SELECTED_ANALYSES)),)
$(error Select only one shipped fNLO analysis module in FO_ANALYSE)
endif
FNLO_SELECTED_ANALYSIS_BRIDGES = \
	$(patsubst %.o,%_bridge.o,$(FNLO_SELECTED_ANALYSES))
FNLO_AUTO_ANALYSIS_BRIDGES = \
	$(filter-out $(FO_ANALYSE),$(FNLO_SELECTED_ANALYSIS_BRIDGES))
FNLO_DUMMY_ANALYSIS_BRIDGES = \
	$(if $(filter analysis_dummy.o,$(FO_ANALYSE)),analysis_dummy_bridge.o) \
	$(if $(filter HwU_dummy.o,$(FO_ANALYSE)),HwU_dummy_bridge.o)
FNLO_AUTO_DUMMY_ANALYSIS_BRIDGES = \
	$(filter-out $(FO_ANALYSE),$(FNLO_DUMMY_ANALYSIS_BRIDGES))
FNLO_EXPLICIT_ANALYSIS_BRIDGES = \
	$(filter $(FNLO_MODULE_ANALYSIS_BRIDGES),$(FO_ANALYSE))
FNLO_WRONG_ANALYSIS_BRIDGES = \
	$(filter-out $(FNLO_SELECTED_ANALYSIS_BRIDGES), \
	$(FNLO_EXPLICIT_ANALYSIS_BRIDGES))
ifneq ($(strip $(FNLO_WRONG_ANALYSIS_BRIDGES)),)
$(error The selected fNLO analysis bridge does not match its module)
endif
FNLO_LINKED_ANALYSIS_BRIDGES = \
	$(sort $(FNLO_AUTO_ANALYSIS_BRIDGES) \
	$(FNLO_EXPLICIT_ANALYSIS_BRIDGES))
ifneq ($(word 2,$(FNLO_LINKED_ANALYSIS_BRIDGES)),)
$(error Only one fNLO analysis ABI bridge may be linked)
endif


